{
  "extends": "zotero-types/entries/sandbox/",
  "include": [
    "src",
    "typings",
    "node_modules/@janbaykara/zotero-preact/src",
    "node_modules/@janbaykara/zotero-jotai-state/src",
    "node_modules/@janbaykara/zotero-cache/src",
    "node_modules/@janbaykara/zotero-chrome/src"
  ],
  "exclude": ["build", "addon"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "preserveSymlinks": true,
    "paths": {
      "react": ["./node_modules/preact/compat/"],
      "react/jsx-runtime": ["./node_modules/preact/jsx-runtime"],
      "react-dom": ["./node_modules/preact/compat/"],
      "react-dom/*": ["./node_modules/preact/compat/*"]
    }
  }
}
